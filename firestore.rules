rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tobi@acourze.com' ||
        request.auth.token.email == 'admin@unitworld.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // PRODUCTS CATALOG: Public can read; Seeding & updates permitted; Deletions restricted to admin
    match /products/{productId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ORDERS & ERP LOGISTICS: Guest & user checkouts allowed; Order tracking accessible
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // USER PROFILES: Users manage their own profile; Admins have oversight
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ADMIN PRIVILEGES
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // MARKETPLACE SETTINGS: Brand and gateway settings readable by all
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // CONNECTION TEST
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
