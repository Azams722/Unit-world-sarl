rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tobi@acourze.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // PRODUCTS CATALOG
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || request.auth.token.email != null);
      allow update: if isSignedIn() && (isAdmin() || request.auth.token.email != null);
      allow delete: if isAdmin();
    }

    // ORDERS & ERP LOGISTICS
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // USER PROFILES
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ADMIN PRIVILEGES
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // MARKETPLACE SETTINGS
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // CONNECTION TEST
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
